{
  "name": "halko-website",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port=5174",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@payloadcms/admin-bar": "^3.86.0",
    "@payloadcms/db-postgres": "^3.86.0",
    "@payloadcms/email-nodemailer": "^3.86.0",
    "@payloadcms/live-preview-react": "^3.86.0",
    "@payloadcms/next": "^3.86.0",
    "@payloadcms/payload-cloud": "^3.86.0",
    "@payloadcms/plugin-cloud-storage": "^3.86.0",
    "@payloadcms/plugin-form-builder": "^3.86.0",
    "@payloadcms/plugin-nested-docs": "^3.86.0",
    "@payloadcms/plugin-redirects": "^3.86.0",
    "@payloadcms/plugin-search": "^3.86.0",
    "@payloadcms/plugin-seo": "^3.86.0",
    "@payloadcms/richtext-lexical": "^3.86.0",
    "@payloadcms/translations": "^3.86.0",
    "@payloadcms/ui": "^3.86.0",
    "@radix-ui/react-checkbox": "^1.3.8",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "17.4.2",
    "geist": "^1.7.2",
    "graphql": "^16.14.2",
    "lucide-react": "^1.25.0",
    "next": "^16.2.11",
    "next-intl": "^4.13.3",
    "next-sitemap": "^4.2.3",
    "payload": "^3.86.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "^16.3.2",
    "@types/escape-html": "^1.0.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "playwright-core": "^1.61.1",
    "postcss": "^8.5.21",
    "prettier": "^3.9.6",
    "sass": "^1.101.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.19.0",
    "pnpm": "^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "@parcel/watcher",
      "@swc/core"
    ],
    "overrides": {
      "sharp": "^0.35.3",
      "esbuild": ">=0.28.0",
      "nodemailer": ">=8.0.6",
      "dompurify": ">=3.4.1",
      "vite": "^7.3.5",
      "postcss": ">=8.5.10"
    }
  },
  "packageManager": "pnpm@10.30.0+sha512.2b5753de015d480eeb88f5b5b61e0051f05b4301808a82ec8b840c9d2adf7748eb352c83f5c1593ca703ff1017295bc3fdd3119abb9686efc96b9fcb18200937"
}
